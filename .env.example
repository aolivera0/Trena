# Copia este archivo a .env.local y completa con los datos de tu proyecto de Firebase
# (Consola de Firebase → Configuración del proyecto → Tus apps → App web).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true = usa los emuladores locales (npm run emulators) en vez del proyecto real.
# Sin VITE_FIREBASE_PROJECT_ID se usa el proyecto de demostración "demo-trena".
VITE_USE_EMULATORS=true
